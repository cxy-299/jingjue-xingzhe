<view class="screen">
  <view class="hero row"><view class="grow"><view class="eyebrow">JINGJUE WALKER</view><view class="title">境觉行者<text class="title-suffix">移动驾驶台</text></view></view><view class="signal {{connected?'online':''}}"><view class="dot"></view>{{connected?'已连接':'未连接'}}</view></view>
  <view class="mode-banner {{demo?'demo-banner':''}}"><text class="pill">{{demo?'离线演示':'电脑中转'}}</text><text>{{demo?'模拟数据 · 不连接机器人':state.firmware || '连接电脑以获取板端状态'}}</text></view>
  <view class="card status-card"><view class="row"><view class="grow"><view class="label">当前任务</view><view class="task-text">{{taskText}}</view></view><view class="state-symbol">{{armed?'RUN':'SAFE'}}</view></view><view class="small muted status-detail">{{error || state.remote.reason || '连接后明确启用本次控制'}}</view><button wx:if="{{!armed}}" class="primary arm" disabled="{{!connected}}" bindtap="arm">启用本次控制</button><view wx:else class="armed-tip">控制许可有效 · 离开页面自动撤销</view></view>
  <block wx:if="{{tab==='drive'}}">
    <view class="grid2 metrics"><view class="card"><view class="label">前方距离 / ToF</view><view class="value">{{distance}}<text class="unit"> mm</text></view><view class="small muted">{{state.sensors.tof_valid?'测距有效':'等待有效测距'}}</view></view><view class="card"><view class="label">车体航向 / IMU</view><view class="value">{{yaw}}<text class="unit"> °</text></view><view class="small muted">{{state.sensors.imu_valid?'姿态有效':'等待有效姿态'}}</view></view></view>
    <view class="card"><view class="row"><view class="section grow">手动驾驶</view><view class="badge">按住运行 · 松手停止</view></view>
      <view class="dpad"><button class="direction forward {{held==='F'?'pressed':''}}" data-dir="F" disabled="{{!armed}}" bindtouchstart="touchStart" bindtouchend="touchEnd" bindtouchcancel="touchEnd"><text class="arrow">↑</text>前进</button><button class="direction left {{held==='L'?'pressed':''}}" data-dir="L" disabled="{{!armed}}" bindtouchstart="touchStart" bindtouchend="touchEnd" bindtouchcancel="touchEnd"><text class="arrow">←</text>左移</button><button class="center-stop danger" bindtap="stop">停止<text>S</text></button><button class="direction right {{held==='R'?'pressed':''}}" data-dir="R" disabled="{{!armed}}" bindtouchstart="touchStart" bindtouchend="touchEnd" bindtouchcancel="touchEnd"><text class="arrow">→</text>右移</button><button class="direction backward {{held==='B'?'pressed':''}}" data-dir="B" disabled="{{!armed}}" bindtouchstart="touchStart" bindtouchend="touchEnd" bindtouchcancel="touchEnd"><text class="arrow">↓</text>后退</button></view>
      <view class="grid3"><button wx:for="{{[12,16,20]}}" wx:key="*this" class="{{speed===item?'selected-speed':''}}" disabled="{{!armed}}" data-value="{{item}}" bindtap="speed">{{item===12?'慢速':item===16?'中速':'标准'}} {{item}}</button></view>
      <view class="grid2 action-row"><button disabled="{{!armed}}" data-dir="left" bindtap="turn">↶ 左转90°</button><button disabled="{{!armed}}" data-dir="right" bindtap="turn">右转90° ↷</button></view>
      <view class="grid2 action-row"><button disabled="{{!armed}}" data-enabled="true" bindtap="avoid">启用前进避障</button><button disabled="{{!armed}}" data-enabled="false" bindtap="avoid">关闭前进避障</button></view>
    </view>
    <view class="card"><view class="section">四轮实时回传</view><view class="wheel-grid"><view class="wheel" wx:for="{{wheels}}" wx:key="name"><view class="row"><text class="accent grow">{{item.name}}</text><text class="small muted">PWM {{item.duty}}</text></view><view class="wheel-value">{{item.actual}}<text class="small muted"> / 目标 {{item.target}}</text></view></view></view><view class="small muted">{{state.sensors.fault?'板端保护已触发':'保护状态正常'}} · {{demo?'四轮数值为模拟数据':'数值来自原驾驶台板端回传'}}</view></view>
  </block>
  <block wx:if="{{tab==='map'}}">
    <view class="card"><view class="row"><view class="section grow">板内自主导航</view><view class="badge">20 × 20</view></view><canvas canvas-id="map" id="map" class="map" style="height:{{mapWidth}}px" bindtap="mapTap"></canvas><view class="map-legend small"><text class="accent">● 当前位置</text><text class="gold">● 终点 / 测点</text><text class="muted">■ 安全区</text></view><view class="small muted">点击空闲格预览终点；蓝线为电脑参考，实际路线由 FPGA 规划。</view><view class="coordinate row"><view class="grow">当前 ({{state.map.current[0]}}, {{state.map.current[1]}})</view><view>终点 ({{state.map.goal[0]}}, {{state.map.goal[1]}})</view></view><button class="primary" disabled="{{!armed}}" bindtap="navigate">启动板内规划绕障</button></view>
    <view class="card"><view class="section">停车确认位置</view><view class="small muted">坐标原点在左下角，每格10cm；确认后车头朝地图+Y。</view><view class="row input-row"><text>X</text><input class="grow" type="number" value="{{poseX}}" data-key="poseX" bindinput="input"/><text>Y</text><input class="grow" type="number" value="{{poseY}}" data-key="poseY" bindinput="input"/></view><button disabled="{{!connected}}" bindtap="pose">确认实际位置</button><view class="row input-row"><view class="small muted grow">ToF探头退后量 / mm</view><input class="short-input" type="text" value="{{setback}}" data-key="setback" bindinput="input"/></view></view>
  </block>
  <block wx:if="{{tab==='vision'}}">
    <view class="card"><view class="row"><view class="section grow">视觉与智能任务</view><view class="badge">{{state.vision.online?'服务在线':'等待视觉服务'}}</view></view><view class="camera"><image wx:if="{{frame}}" src="{{frame}}" mode="aspectFit"/><view wx:elif="{{demo}}" class="demo-target"><view class="paper"><view class="paper-mark"></view><text>{{digit}}</text><view class="target-bracket tl"></view><view class="target-bracket tr"></view><view class="target-bracket bl"></view><view class="target-bracket br"></view></view><view class="camera-tag">数字靶标 · 模拟画面</view></view><view wx:else class="muted camera-empty">点击获取相机快照</view></view><view class="row camera-info"><view class="grow small muted">{{demo?'20.0 FPS · 内置演示':frameMessage || state.vision.message}}</view><button wx:if="{{!demo}}" size="mini" bindtap="frame">刷新快照</button></view><view class="small muted">{{state.vision.model || 'Printed Digit 0–9'}}</view></view>
    <view class="card"><view class="section">指定数字与任务参数</view><view class="grid2"><view><view class="label">目标数字</view><picker range="{{digits}}" value="{{digit}}" bindchange="digit">{{digits[digit]}} ▾</picker></view><view><view class="label">到达距离 / mm</view><input type="number" value="{{arrival}}" data-key="arrival" bindinput="input"/></view></view><view class="grid2 action-row"><button disabled="{{!connected}}" data-action="vision.search" bindtap="vision">搜索数字</button><button disabled="{{!connected}}" data-action="vision.prepare" bindtap="vision">准备新任务</button></view><view class="spacer"></view><button disabled="{{!connected}}" data-action="task.read" bindtap="task">读取已准备任务</button><view class="spacer"></view><button class="primary" disabled="{{!armed}}" data-action="task.start" bindtap="task">启动智能接近任务</button></view>
    <view class="card"><view class="section">当前识别目标</view><view wx:if="{{!state.vision.detections.length}}" class="small muted">暂无可选目标，请将数字放入画面后刷新。</view><button class="detection-row" wx:for="{{state.vision.detections}}" wx:key="detection_id" data-row="{{item}}" bindtap="lock">{{item.class_name}} · #{{item.detection_id}}<text class="accent"> 点选并确认</text></button></view>
    <view class="card"><view class="section">目标跟随</view><view class="grid2"><button disabled="{{!armed}}" data-action="follow.start" bindtap="task">ToF 跟随20cm</button><button disabled="{{!armed}}" data-action="follow.digit" bindtap="task">数字确认后跟随</button></view></view>
  </block>
  <block wx:if="{{tab==='connect'}}">
    <view class="card"><view class="row"><view class="grow"><view class="section">离线演示</view><view class="small muted">无需 AppID、电脑或机器人</view></view><switch checked="{{demo}}" color="#42ddbd" bindchange="switchDemo"/></view></view>
    <view wx:if="{{!demo}}" class="card"><view class="section">连接电脑中转</view><view class="label">电脑网关地址</view><input value="{{base}}" data-key="base" bindinput="input" placeholder="http://192.168.1.8:8765"/><view class="spacer"></view><view class="label">本次配对码</view><input password="{{true}}" value="{{token}}" data-key="token" bindinput="input" placeholder="复制电脑驾驶台显示的配对码"/><view class="grid2 action-row"><button class="primary" bindtap="connect">连接网关</button><button bindtap="disconnect">断开并停车</button></view><view class="small muted guide">手机与电脑使用同一 Wi‑Fi。电脑需连接原蓝牙，并明确勾选本次手机控制和原运动许可。配对码只在内存保存。</view></view>
    <view class="card"><view class="section">控制链路</view><view class="connection-flow"><view>微信小程序</view><text>↓ 同一局域网</text><view>电脑网关 · 原驾驶台</view><text>↓ 现有蓝牙串口</text><view>FPGA · 电机与传感器</view></view><view class="small muted guide">{{demo?'当前所有操作仅改变模拟状态。':'连接成功不会自动开车；手机后台、断开或许可超时后需重新启用。'}}</view></view>
    <view class="card"><view class="row" bindtap="toggleAdvanced"><view class="section grow">维护与诊断</view><text class="muted">{{advanced?'收起 −':'展开 +'}}</text></view><block wx:if="{{advanced}}"><view class="grid3"><view><view class="label">P</view><input type="number" value="{{p}}" data-key="p" bindinput="input"/></view><view><view class="label">I</view><input type="number" value="{{i}}" data-key="i" bindinput="input"/></view><view><view class="label">D</view><input type="number" value="{{d}}" data-key="d" bindinput="input"/></view></view><view class="spacer"></view><button disabled="{{!armed}}" bindtap="pid">停车后发送 PID 参数</button><view class="small muted guide">P、D 0–32；I 0–8。发送后撤销运动许可，电脑需重新核对。</view><view class="log small muted" wx:for="{{state.remote.events}}" wx:key="at">{{item.message}}</view></block></view>
  </block>
  <view class="footer"><view class="stop-bar" bindtap="stop"><view class="stop-icon">■</view><view class="grow">停止 S<view class="stop-sub">取消当前运动与任务</view></view><text class="stop-key">STOP</text></view><view class="tabbar"><view wx:for="{{tabs}}" wx:key="id" data-tab="{{item.id}}" bindtap="selectTab" class="tab {{tab===item.id?'active':''}}"><view class="tab-mark">{{item.mark}}</view><text>{{item.name}}</text></view></view></view>
</view>
