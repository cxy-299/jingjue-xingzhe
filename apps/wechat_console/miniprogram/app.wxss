page{background:#07111b;color:#e7f1f6;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx}button{font-size:26rpx;border-radius:18rpx;line-height:1.4;padding:23rpx 18rpx;background:#153244;color:#dfedf4;border:1rpx solid #2b4c5d;margin:0}button::after{border:0}button[disabled]{background:#112330!important;color:#596e7b!important;border-color:#203541!important}input{background:#071722;border:1rpx solid #294554;border-radius:14rpx;padding:22rpx;color:#e7f1f6;min-height:40rpx}picker{background:#102a3a;border:1rpx solid #2c4859;border-radius:14rpx;padding:22rpx}canvas{display:block} .muted{color:#8ba6b7}.small{font-size:23rpx;line-height:1.65}.accent{color:#44e3c1}.row{display:flex;align-items:center;gap:16rpx}.grow{flex:1;min-width:0}.primary{background:#42ddbd;color:#06251f;border-color:#42ddbd;font-weight:700}.danger{background:#432932;border-color:#86505b;color:#ffb6b6}.section{font-size:30rpx;font-weight:700;margin-bottom:22rpx}.card{background:#0d1d2a;border:1rpx solid #203847;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}.label{font-size:22rpx;color:#8ba6b7;margin-bottom:10rpx}.value{font-size:36rpx;font-weight:700}.spacer{height:20rpx}.badge{border:1rpx solid #2b4c5d;border-radius:24rpx;padding:7rpx 16rpx;font-size:22rpx;color:#9eb6c4}.pill{display:inline-block;color:#44e3c1;background:#12382f;border-radius:20rpx;font-size:21rpx;padding:7rpx 14rpx}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14rpx}
