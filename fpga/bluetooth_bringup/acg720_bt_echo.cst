// ACG720 GW5AT-60B：蓝牙输入 P7-23/E16，蓝牙输出 P7-24/D16。
IO_LOC "clk_50m_i" Y18;
IO_PORT "clk_50m_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "key_s0_n_i" F15;
IO_PORT "key_s0_n_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "bt_uart_rx_i" E16;
IO_PORT "bt_uart_rx_i" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "bt_uart_tx_o" D16;
IO_PORT "bt_uart_tx_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// 延用已核对的四路电机管脚，但此诊断顶层将全部输出绑为 0。
IO_LOC "motor_pwm_o[0]" A13;
IO_LOC "motor_in1_o[0]" A14;
IO_LOC "motor_in2_o[0]" A15;
IO_LOC "motor_pwm_o[1]" A16;
IO_LOC "motor_in1_o[1]" A18;
IO_LOC "motor_in2_o[1]" A19;
IO_LOC "motor_pwm_o[2]" F13;
IO_LOC "motor_in1_o[2]" F14;
IO_LOC "motor_in2_o[2]" E13;
IO_LOC "motor_pwm_o[3]" E14;
IO_LOC "motor_in1_o[3]" C13;
IO_LOC "motor_in2_o[3]" B13;
IO_PORT "motor_pwm_o[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_PORT "motor_pwm_o[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_PORT "motor_pwm_o[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_PORT "motor_pwm_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_PORT "motor_in1_o[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_PORT "motor_in1_o[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_PORT "motor_in1_o[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_PORT "motor_in1_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_PORT "motor_in2_o[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_PORT "motor_in2_o[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_PORT "motor_in2_o[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_PORT "motor_in2_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;

IO_LOC "led_o[0]" L21;
IO_LOC "led_o[1]" K21;
IO_LOC "led_o[2]" K22;
IO_LOC "led_o[3]" J22;
IO_LOC "led_o[4]" H22;
